#version 450
// render_burst compute Work: `iters` dependent ALU steps per invocation, result stored so it can't be elided.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint v[]; } b;
layout(push_constant) uniform P { uint iters; uint seed; } p;
void main() {
    uint x = gl_GlobalInvocationID.x ^ p.seed;
    for (uint i = 0u; i < p.iters; ++i) x = x * 1664525u + 1013904223u;
    b.v[gl_GlobalInvocationID.x] = x;
}
